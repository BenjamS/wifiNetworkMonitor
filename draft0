// --- Memory Safe Data Structures ---
struct MacRecord {
  uint8_t mac[6];
  uint32_t bytes;
  char vendor[25];  // The box to hold the 24-character company name + null terminator
  bool vendorFound; // The flag so we only search the SD card once per device
};

