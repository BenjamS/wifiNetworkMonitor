//--- SD Card Binary Search (MAC vendor (OUI) look up function) ---
void resolveMacVendor(MacRecord* record) {
  // If we already found it, don't waste time on the SD card
  if (record->vendorFound) return;

  // Default fallback if not found
  sprintf(record->vendor, "Unknown Device");
  record->vendorFound = true; // Mark as searched so we don't try again

  char target[7];
  sprintf(target, "%02X%02X%02X", record->mac[0], record->mac[1], record->mac[2]);

  // Use SdFat's FsFile and O_READ
  FsFile file = sd.open("/oui_db.txt", O_READ);
  if (!file) return;

  uint32_t low = 0;
  // Use SdFat's fileSize() function
  uint32_t high = (file.fileSize() / 32) - 1;

  while (low <= high) {
    uint32_t mid = low + (high - low) / 2;
    file.seek(mid * 32);

    char line[32];
    file.read(line, 32);

    char prefix[7];
    strncpy(prefix, line, 6);
    prefix[6] = '\0';

    int cmp = strcmp(target, prefix);

    if (cmp == 0) {
      // Found the target! Extract the 24-character vendor name
      strncpy(record->vendor, &line[7], 24);
      record->vendor[24] = '\0';

      // Trim trailing spaces from the Python padding
      for(int i = 23; i >= 0; i--) {
        if(record->vendor[i] == ' ') record->vendor[i] = '\0';
        else break;
      }
      break;
    }
    else if (cmp < 0) {
      if (mid == 0) break;
      high = mid - 1;
    }
    else {
      low = mid + 1;
    }
  }
  file.close();
}

