// --- 3. The Main Loop ---
void loop() {
  uint16_t t_x = 0, t_y = 0;

// --- RAW SPI HARDWARE DIAGNOSTIC ---
  static unsigned long lastDebugPrint = 0;
  if (millis() - lastDebugPrint > 500) {
    lastDebugPrint = millis();
    uint16_t z_pressure = tft.getTouchRawZ();
    Serial.printf("Raw Touch Z (Pressure): %d\n", z_pressure);
  }

  // Check if screen is touched
// Check if screen is touched
  bool pressed = tft.getTouch(&t_x, &t_y);

  if (pressed) {
    Serial.printf("Touch Detected! X: %d, Y: %d\n", t_x, t_y);
    if (currentState == SCREEN_CHART) {
      // Hitbox for Top-Right MENU Button (x: > 400, y: < 40)
      if (t_x > 400 && t_y < 40) {
        currentState = SCREEN_MENU;
        pause_sniffing = true;           // Stop RAM corruption
        esp_wifi_set_promiscuous(false); // Kill radio for clean SPI bus sharing
        drawMenu();
        delay(300); // Debounce
      }
    }
    else if (currentState == SCREEN_MENU) {

      // Hitbox for "Toggle Scale"
      if (t_x > 50 && t_x < 250 && t_y > 100 && t_y < 150) {
        useLogScale = !useLogScale;
        drawMenu();
        delay(300);
      }

      // Hitbox for "Select Target AP"
      // (Make sure these coordinates match the drawRect you just made!)
      if (t_x > 50 && t_x < 250 && t_y > 175 && t_y < 225) {
        currentState = SCREEN_AP_SCAN;
        drawApScanner();
        delay(300); // Debounce
      }

      // Hitbox for "Exit"
      if (t_x > 300 && t_x < 450 && t_y > 250 && t_y < 300) {
        currentState = SCREEN_CHART;
        tft.fillScreen(TFT_BLACK);
        drawChartHeader();               // Redraw the header and button!
        esp_wifi_set_promiscuous(true);  // Wake radio back up
        pause_sniffing = false;          // Resume data collection
        delay(300);
      }
    }
  }
  // --- CHART LOGIC ---
  if (currentState == SCREEN_CHART) {
    static unsigned long lastHop = 0;

    if (millis() - lastHop > HOP_INTERVAL) {
      lastHop = millis();
      current_ch_idx++;

      bool full_sweep_complete = false;
      if (current_ch_idx >= NUM_CHANNELS) {
        current_ch_idx = 0;
        full_sweep_complete = true;
      }

      esp_wifi_set_channel(CHANNELS[current_ch_idx], WIFI_SECOND_CHAN_NONE);

      tft.setTextSize(2);
      tft.setTextColor(TFT_WHITE, TFT_BLACK);
      tft.setCursor(5, 5);
      tft.printf("CH: %02d | ESP32 NOC Monitor   ", CHANNELS[current_ch_idx]);

      if (full_sweep_complete) {

        // Use the manual interrupt flag to prevent the race condition bug
        pause_sniffing = true;
        memcpy(sortData, (void*)liveData, sizeof(liveData));
        sortMacCount = liveMacCount;
        sortOtherBytes = liveOtherBytes;
        memset((void*)liveData, 0, sizeof(liveData));
        liveMacCount = 0;
        liveOtherBytes = 0;
        pause_sniffing = false;

        // Bubble sort
        for (int i = 0; i < sortMacCount - 1; i++) {
          for (int j = 0; j < sortMacCount - i - 1; j++) {
            if (sortData[j].bytes < sortData[j+1].bytes) {
              MacRecord temp = sortData[j];
              sortData[j] = sortData[j+1];
              sortData[j+1] = temp;
            }
          }
        }

        for(int i = 8; i < sortMacCount; i++) {
          sortOtherBytes += sortData[i].bytes;
        }

        // DRAW LEGEND
        tft.fillRect(0, 25, 480, HEADER_HEIGHT - 25, TFT_BLACK);
        tft.setTextSize(1);
        for(int i = 0; i < 8 && i < sortMacCount; i++) {

          resolveMacVendor(&sortData[i]);
          tft.setTextColor(colors[i]);

          // --- KEEP: 3 Columns, 155px apart ---
          int x_pos = 5 + (i % 3) * 155;
          int y_pos = 30 + (i / 3) * 15;
          tft.setCursor(x_pos, y_pos);

          tft.print(sortData[i].vendor);
        }

        // --- NEW: PLACE "OTHER DEVICES" AS THE 9TH ITEM IN THE GRID ---
        tft.setTextColor(colors[8]);
        tft.setCursor(315, 60); // Exact coordinates for the bottom-right slot

        // Calculate how many devices are bundled into "Other"
        int otherCount = 0;
        if (sortMacCount > 8) {
          otherCount = sortMacCount - 8;
        }

        // Print the label with the dynamic count appended
        tft.printf("OTHER DEVICES (%d)", otherCount);

        // DRAW CHART (Unified Log & Linear Math)
        tft.fillRect(current_x + 1, HEADER_HEIGHT + 1, 10, CHART_BOTTOM - HEADER_HEIGHT, TFT_BLACK);

        int current_y = CHART_BOTTOM;
        uint32_t total_bytes = sortOtherBytes;
        for(int i = 0; i < 8 && i < sortMacCount; i++) total_bytes += sortData[i].bytes;

        if (total_bytes > 0) {
          double log_total = 0;

          // Pre-calculate the total log denominator if necessary
          if (useLogScale) {
            for(int j = 0; j < 8 && j < sortMacCount; j++) {
              log_total += log10((double)sortData[j].bytes + 1.0);
            }
            log_total += log10((double)sortOtherBytes + 1.0);
          }

          // 1. Draw Top 8
          for(int i = 0; i < 8 && i < sortMacCount; i++) {
            double fraction;
            if (useLogScale) {
              fraction = log10((double)sortData[i].bytes + 1.0) / log_total;
            } else {
              fraction = (double)sortData[i].bytes / (double)total_bytes;
            }

            int bar_height = (int)(fraction * (CHART_BOTTOM - HEADER_HEIGHT));
            if (bar_height > (CHART_BOTTOM - HEADER_HEIGHT)) bar_height = CHART_BOTTOM - HEADER_HEIGHT;

            tft.drawLine(current_x, current_y, current_x, current_y - bar_height, colors[i]);
            tft.drawLine(current_x + 1, current_y, current_x + 1, current_y - bar_height, colors[i]);

            current_y -= bar_height;
          }

          // 2. Draw Other (and patch the integer rounding gap)
          if (sortOtherBytes > 0 && current_y > HEADER_HEIGHT) {
            // No log/linear math needed here!
            // Just let the final grey block stretch to the ceiling to absorb the rounding error.
            tft.drawLine(current_x, current_y, current_x, HEADER_HEIGHT + 1, colors[8]);
            tft.drawLine(current_x + 1, current_y, current_x + 1, HEADER_HEIGHT + 1, colors[8]);
          }
          else if (sortOtherBytes == 0 && current_y > HEADER_HEIGHT && sortMacCount > 0) {
            // If there is no "Other" data, stretch the top-most MAC address bar to the ceiling instead
            tft.drawLine(current_x, current_y, current_x, HEADER_HEIGHT + 1, colors[sortMacCount - 1]);
            tft.drawLine(current_x + 1, current_y, current_x + 1, HEADER_HEIGHT + 1, colors[sortMacCount - 1]);
          }
        }

        current_x += 2;
        if (current_x >= 478) current_x = 0;
      }
    }
  }
}
