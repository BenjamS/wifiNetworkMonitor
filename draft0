// --- 1. The Wi-Fi Sniffer Callback ---
void sniffer_callback(void* buf, wifi_promiscuous_pkt_type_t type) {
  if (pause_sniffing) return; // Drop packets immediately if we are sorting or in the menu
  wifi_promiscuous_pkt_t *pkt = (wifi_promiscuous_pkt_t *)buf;
  uint16_t len = pkt->rx_ctrl.sig_len;

  uint8_t* mac1 = pkt->payload + 4;  // Destination
  uint8_t* mac2 = pkt->payload + 10; // Source
  uint8_t* mac3 = pkt->payload + 16; // BSSID

  // Apply BSSID filter if active
  if (use_filter) {
      if (memcmp(mac1, TARGET_BSSID, 6) != 0 &&
          memcmp(mac2, TARGET_BSSID, 6) != 0 &&
          memcmp(mac3, TARGET_BSSID, 6) != 0) {
          return; // Drop packet, not on our target network
      }
  }

  // We track the Source MAC (who is transmitting right now)
  uint8_t* target_mac = mac2;

  // Don't track the router itself in the legend, we care about clients
  if (use_filter && memcmp(target_mac, TARGET_BSSID, 6) == 0) return;

  for(int i = 0; i < liveMacCount; i++) {
    if(memcmp((void*)liveData[i].mac, target_mac, 6) == 0) {
      liveData[i].bytes += len;
      return;
    }
  }

  if(liveMacCount < MAX_MACS) {
    memcpy((void*)liveData[liveMacCount].mac, target_mac, 6);
    liveData[liveMacCount].bytes = len;
    liveMacCount++;
  } else {
    liveOtherBytes += len;
  }
}

